#!/usr/bin/env bash
# Pre-commit hook: runs every model-free repo check (scripts/check.sh) and refuses the commit
# when one fails — stale catalog views, a reference without its manifest row, a house rule that
# outgrew its hook slots, a broken host manifest, or a drifted INSTALL.md.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
bash scripts/check.sh
