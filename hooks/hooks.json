{
  "description": "Injects the Rock RMS house rules into context at the start of every session.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/inject-rules.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
